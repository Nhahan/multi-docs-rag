OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_RERANK_MODEL=qwen3-embedding:4b
OLLAMA_CHAT_THINK=false
OLLAMA_CHAT_TEMPERATURE=0
OLLAMA_REQUEST_TIMEOUT_MS=300000
INGEST_EMBED_BATCH_SIZE=16
INGEST_CHUNK_SIZE=900
INGEST_CHUNK_OVERLAP=160
# Optional corpus source selection (comma/semicolon/newline separated)
# If absent, corpus is auto-discovered from files in CORPUS_PATH (and CORPUS_PATH/docs).
CORPUS_SOURCE_FILES=CFR - Code of Federal Regulations.pdf,Agent_Memory_Below_the_Prompt.pdf

# Optional explicit JSON override for per-document metadata (highest priority):
# Optional override: JSON array of { source_file, document_id }
# CORPUS_CONFIG_JSON='[
#   {"source_file":"document-a.pdf","document_id":"document-a"},
#   {"source_file":"document-b.pdf","document_id":"document-b"}
# ]'

RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_ALLOW_DENSE_FALLBACK=true
RETRIEVAL_RERANK_TOP_K=8
RETRIEVAL_ENABLE_RERANK=true
OLLAMA_INSUFFICIENT_EVIDENCE_MESSAGE=I cannot answer from the indexed evidence.

CORPUS_PATH=data
CHUNKS_PATH=data/index/chunks.json
VECTOR_STORE_PATH=data/index/vector-store.json
LEXICAL_INDEX_PATH=data/index/lexical-index.json
